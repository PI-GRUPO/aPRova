{
  "openapi": "3.1.0",
  "info": {
    "title": "aPRova — leitura de análises F4A",
    "version": "0.4.0",
    "description": "Contrato implementado em 16/11/2026. Sessão GitHub App da F3; homologação OAuth real pendente. Apenas GETs. Não inclui APIs planejadas de métricas/gestão. Consulte dashboard-f4a.md e dashboard-f3.md para configuração e limites."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/analises": {
      "get": {
        "operationId": "listarAnalises",
        "summary": "Lista de análises por sessão web ou serviço HMAC",
        "description": "Com assinatura HMAC explícita, preserva o contrato de serviço anterior. Sem esse cabeçalho, usa a sessão web quando configurada. O modo web devolve total completo e snapshot; não expõe filas nem faz mutações. Ordenação por recebimento e UUID; snapshot exclui inserções posteriores. O estado de linhas existentes continua atual e pode alterar o conjunto filtrado. Total e itens compartilham transação repeatable read.",
        "security": [
          {
            "sessao": []
          },
          {
            "assinaturaN8N": [],
            "timestampN8N": []
          }
        ],
        "parameters": [
          {
            "name": "installation_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "A sessão precisa ter acesso confirmado pelo GitHub a esta instalação; o parâmetro não concede autorização."
          },
          {
            "name": "repositorio",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Restrição opcional dentro dos repositórios autorizados. Fora do escopo devolve 403 no modo web."
          },
          {
            "name": "numero_pr",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "description": ""
          },
          {
            "name": "estado",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "todos",
                "em_andamento",
                "pendente",
                "mapeando_contexto",
                "gerando",
                "testando_sandbox",
                "avaliando_risco",
                "aguardando_aprovacao",
                "aplicando",
                "concluido",
                "rejeitado",
                "falhou"
              ]
            },
            "description": "Web: todos por padrão; em_andamento é exclusivo do contrato HMAC, no qual é o padrão."
          },
          {
            "name": "nivel",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "todos",
                "baixo",
                "medio",
                "alto",
                "nao_avaliado"
              ],
              "default": "todos"
            },
            "description": "Somente web; null significa ausência de gate, nunca risco baixo."
          },
          {
            "name": "inicio",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Somente web. Inclusivo, UTC; padrão: início da janela de 30 dias, incluindo hoje."
          },
          {
            "name": "fim",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Somente web. Exclusivo, UTC; padrão: meia-noite de amanhã."
          },
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 201,
              "default": 1
            },
            "description": ""
          },
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            },
            "description": ""
          },
          {
            "name": "ordem",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "recentes",
                "antigas"
              ],
              "default": "recentes"
            },
            "description": "Somente web. Desempate por UUID decrescente."
          },
          {
            "name": "snapshot",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Somente web. Obrigatório após a primeira página; reutilizar exatamente o valor recebido e manter os filtros. Instante futuro é recusado."
          }
        ],
        "responses": {
          "200": {
            "description": "Consulta autorizada, sem cache.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/PaginaWeb"
                    },
                    {
                      "$ref": "#/components/schemas/PaginaServico"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Parâmetros inválidos ou repetidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Sessão ausente/expirada ou HMAC inválido; o serviço pode retornar corpo vazio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Instalação/repositório fora do escopo web.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "UUID inexistente ou fora dos repositórios/tenant autorizados.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Falha de leitura.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "503": {
            "description": "Fonte ou autorização indisponível.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/api/analises/{id}": {
      "get": {
        "operationId": "detalharAnalise",
        "summary": "Detalhe de uma análise no escopo autorizado",
        "security": [
          {
            "sessao": []
          },
          {
            "assinaturaN8N": [],
            "timestampN8N": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "installation_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "A sessão precisa ter acesso confirmado pelo GitHub a esta instalação; o parâmetro não concede autorização."
          },
          {
            "name": "repositorio",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Restrição opcional dentro dos repositórios autorizados. Fora do escopo devolve 403 no modo web."
          }
        ],
        "description": "Modo web: dados agregados do mesmo UUID e tenant, incluindo timeline, tentativas, gate, calibração, aprovações e recibo. UUID de outro tenant ou repositório autorizado não visível retorna 404. Branch/rede/suítes ausentes não são inferidas. Saída limitada a 65536 caracteres por tentativa, com indicação explícita; renderizar como texto. Casos semelhantes fora dos repositórios autorizados são omitidos. Uma decisão sem SHA correspondente não é aplicada ao commit. atual=false indica outra análise mais recente do mesmo PR. HMAC preserva resumo anterior sem os agregados.",
        "responses": {
          "200": {
            "description": "Consulta autorizada, sem cache.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/DetalheWeb"
                    },
                    {
                      "$ref": "#/components/schemas/DetalheServico"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Parâmetros inválidos ou repetidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Sessão ausente/expirada ou HMAC inválido; o serviço pode retornar corpo vazio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Instalação/repositório fora do escopo web.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "UUID inexistente ou fora dos repositórios/tenant autorizados.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Falha de leitura.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "503": {
            "description": "Fonte ou autorização indisponível.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/api/repositorios": {
      "get": {
        "operationId": "listarRepositoriosAutorizados",
        "summary": "Catálogo de nomes de repositórios autorizados pelo GitHub",
        "security": [
          {
            "sessao": []
          }
        ],
        "parameters": [
          {
            "name": "installation_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "A sessão precisa ter acesso confirmado pelo GitHub a esta instalação; o parâmetro não concede autorização."
          }
        ],
        "description": "Consulta todas as páginas de repositórios autorizados. Não afirma saúde, check obrigatório ou permissões administrativas. Instalação sem repositórios acessíveis retorna 403.",
        "responses": {
          "200": {
            "description": "Consulta autorizada, sem cache.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Repositorios"
                }
              }
            }
          },
          "400": {
            "description": "Parâmetros inválidos ou repetidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Sessão ausente/expirada ou HMAC inválido; o serviço pode retornar corpo vazio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Instalação/repositório fora do escopo web.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "UUID inexistente ou fora dos repositórios/tenant autorizados.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Falha de leitura.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "503": {
            "description": "Fonte ou autorização indisponível.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessao": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-aprova_sessao",
        "description": "Cookie opaco HttpOnly, Secure, SameSite=Lax. HTTP em localhost usa aprova_sessao. Tokens GitHub não vão ao navegador."
      },
      "assinaturaN8N": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Aprova-Assinatura",
        "description": "sha256=HMAC-SHA256 do segredo sobre timestamp + ponto + método + newline + caminho escapado + newline + query literal. A presença do cabeçalho escolhe HMAC; assinatura inválida não recorre à sessão."
      },
      "timestampN8N": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Aprova-Timestamp",
        "description": "Timestamp autenticado conforme contrato existente do n8n."
      }
    },
    "schemas": {
      "Erro": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "Analise": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "repositorio": {
            "type": "string"
          },
          "numero_pr": {
            "type": "integer",
            "minimum": 0
          },
          "sha_head": {
            "type": "string"
          },
          "estado": {
            "type": "string",
            "enum": [
              "pendente",
              "mapeando_contexto",
              "gerando",
              "testando_sandbox",
              "avaliando_risco",
              "aguardando_aprovacao",
              "aplicando",
              "concluido",
              "rejeitado",
              "falhou"
            ]
          },
          "recebido_em": {
            "type": "string",
            "format": "date-time"
          },
          "criado_em": {
            "type": "string",
            "format": "date-time"
          },
          "atualizado_em": {
            "type": "string",
            "format": "date-time"
          },
          "autor": {
            "type": "string"
          },
          "nivel": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "baixo",
                  "medio",
                  "alto"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "repositorio",
          "numero_pr",
          "sha_head",
          "estado",
          "recebido_em",
          "criado_em",
          "atualizado_em",
          "autor",
          "nivel"
        ]
      },
      "ResumoServico": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "repositorio": {
            "type": "string"
          },
          "numero_pr": {
            "type": "integer",
            "minimum": 0
          },
          "sha_head": {
            "type": "string"
          },
          "estado": {
            "type": "string",
            "enum": [
              "pendente",
              "mapeando_contexto",
              "gerando",
              "testando_sandbox",
              "avaliando_risco",
              "aguardando_aprovacao",
              "aplicando",
              "concluido",
              "rejeitado",
              "falhou"
            ]
          },
          "recebido_em": {
            "type": "string",
            "format": "date-time"
          },
          "criado_em": {
            "type": "string",
            "format": "date-time"
          },
          "atualizado_em": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "repositorio",
          "numero_pr",
          "sha_head",
          "estado",
          "recebido_em",
          "criado_em",
          "atualizado_em"
        ]
      },
      "PaginaWeb": {
        "type": "object",
        "properties": {
          "installation_id": {
            "type": "integer",
            "minimum": 0
          },
          "snapshot": {
            "type": "string",
            "format": "date-time"
          },
          "pagina": {
            "type": "integer",
            "minimum": 0
          },
          "limite": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "tem_mais": {
            "type": "boolean"
          },
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Analise"
            }
          }
        },
        "required": [
          "installation_id",
          "snapshot",
          "pagina",
          "limite",
          "total",
          "tem_mais",
          "itens"
        ]
      },
      "PaginaServico": {
        "type": "object",
        "properties": {
          "installation_id": {
            "type": "integer",
            "minimum": 0
          },
          "consultado_em": {
            "type": "string",
            "format": "date-time"
          },
          "estado": {
            "type": "string"
          },
          "repositorio": {
            "type": "string"
          },
          "numero_pr": {
            "type": "integer",
            "minimum": 0
          },
          "pagina": {
            "type": "integer",
            "minimum": 0
          },
          "limite": {
            "type": "integer",
            "minimum": 0
          },
          "tem_mais": {
            "type": "boolean"
          },
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResumoServico"
            }
          }
        },
        "required": [
          "installation_id",
          "consultado_em",
          "estado",
          "repositorio",
          "numero_pr",
          "pagina",
          "limite",
          "tem_mais",
          "itens"
        ]
      },
      "DetalheServico": {
        "type": "object",
        "properties": {
          "installation_id": {
            "type": "integer",
            "minimum": 0
          },
          "consultado_em": {
            "type": "string",
            "format": "date-time"
          },
          "analise": {
            "$ref": "#/components/schemas/ResumoServico"
          }
        },
        "required": [
          "installation_id",
          "consultado_em",
          "analise"
        ]
      },
      "Repositorios": {
        "type": "object",
        "properties": {
          "installation_id": {
            "type": "integer",
            "minimum": 0
          },
          "repositorios": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "installation_id",
          "repositorios"
        ]
      },
      "Motivo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nivel": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "evidencias": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "nivel",
          "descricao",
          "evidencias"
        ]
      },
      "Vizinho": {
        "type": "object",
        "properties": {
          "task_run_id": {
            "type": "string",
            "format": "uuid"
          },
          "repositorio": {
            "type": "string"
          },
          "numero_pr": {
            "type": "integer",
            "minimum": 0
          },
          "similaridade": {
            "type": "number"
          },
          "desfecho": {
            "type": "string"
          },
          "motivos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "task_run_id",
          "repositorio",
          "numero_pr",
          "similaridade",
          "desfecho"
        ]
      },
      "Gate": {
        "type": "object",
        "properties": {
          "nivel_deterministico": {
            "type": "string",
            "enum": [
              "baixo",
              "medio",
              "alto"
            ]
          },
          "nivel": {
            "type": "string",
            "enum": [
              "baixo",
              "medio",
              "alto"
            ]
          },
          "motivo": {
            "type": "string"
          },
          "motivos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Motivo"
            }
          },
          "calibracao_estado": {
            "type": "string"
          },
          "calibracao_razao": {
            "type": "string"
          },
          "vizinhos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Vizinho"
            }
          }
        },
        "required": [
          "nivel_deterministico",
          "nivel",
          "motivo",
          "motivos",
          "calibracao_estado",
          "calibracao_razao",
          "vizinhos"
        ]
      },
      "Etapa": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "de": {
            "type": "string"
          },
          "para": {
            "type": "string"
          },
          "detalhe": {
            "type": "string"
          },
          "criado_em": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "de",
          "para",
          "detalhe",
          "criado_em"
        ]
      },
      "Tentativa": {
        "type": "object",
        "properties": {
          "tentativa": {
            "type": "integer",
            "minimum": 0
          },
          "compilou": {
            "type": "boolean"
          },
          "testes_passaram": {
            "type": "integer",
            "minimum": 0
          },
          "testes_falharam": {
            "type": "integer",
            "minimum": 0
          },
          "saida": {
            "type": "string"
          },
          "saida_truncada": {
            "type": "boolean"
          },
          "duracao_ms": {
            "type": "integer",
            "minimum": 0
          },
          "tipo_falha": {
            "type": "string"
          },
          "criado_em": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "tentativa",
