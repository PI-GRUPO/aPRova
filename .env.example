# quando precisar das variaveis me manda mensagem no whatsapp

# servidor
PORT=8080
LOG_LEVEL=debug
APROVA_URL_PUBLICA=

# banco
DATABASE_URL=postgres://aprova:aprova@localhost:5432/aprova?sslmode=disable

# redis
REDIS_URL=redis://localhost:6379/0

# github app
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

# recibo (Ed25519)
RECEIPT_PRIVATE_KEY_BASE64=
RECEIPT_PUBLIC_KEY_BASE64=


# sandbox
SANDBOX_EXECUTOR=local
SANDBOX_IMAGEM_GO=

# azure
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_GROUP=
AZURE_SANDBOX_JOB_NAME=

# n8n local e opcional (Docker Compose, perfil automacao)
# Ao mudar a porta, ajuste tambem a URL base.
N8N_PORTA_LOCAL=5978
N8N_URL_BASE=http://localhost:5978/
GENERIC_TIMEZONE=America/Sao_Paulo

# Integracao com a API: opcional para apenas abrir o editor do n8n.
# URL completa do workflow, por exemplo http://localhost:5978/webhook/aprova.
N8N_WEBHOOK_URL=

N8N_SEGREDO_ACOES=
N8N_SEGREDO_EVENTOS=
SLACK_GITHUB_VINCULOS=
