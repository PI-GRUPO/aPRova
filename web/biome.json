{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"src/**",
			"e2e/**",
			"scripts/**",
			"*.ts",
			"*.json",
			"!src/dados",
			"!node_modules",
			"!dist",
			"!test-results",
			"!.impeccable",
			"!src/ativos"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 140
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
